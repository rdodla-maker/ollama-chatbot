# Ollama and model
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# Backward-compatible alias still accepted by the backend
MODEL_NAME=llama3

# Storage (defaults work when running uvicorn from backend/)
CHROMA_PATH=backend/chroma_db
UPLOAD_DIR=backend/uploads
ALLOWED_FS_ROOT=C:/Users/rdodla/ollama-chatbot

# Limits
MAX_UPLOAD_MB=25
MAX_FILE_SIZE=500000

# CORS — comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Job application MVP integrations
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_PATH=
N8N_WEBHOOK_URL=
APPLICATION_MEMORY_PATH=backend/memory/application_memory.json

# Agent (Wave 2)
USE_LANGGRAPH_AGENT=true
AGENT_MAX_ITERATIONS=10
MEMORY_RECENT_LIMIT=5
CODEBASE_PATHS=backend,frontend/src

# Wave 3
ENABLE_SHELL_TOOL=false
SHELL_TIMEOUT_SECONDS=30
LANGCHAIN_TRACING=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ollama-agentic-ai
